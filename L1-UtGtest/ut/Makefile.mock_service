.PHONY: mock_service

HAL_DIR ?= $(CURDIR)

AVCLOCK_SONAME := avclockaidl
AUDIOSINK_SONAME := audiosinkaidl
AUDIODECODER_SONAME := audiodecoderaidl
VIDEOSINK_SONAME := videosinkaidl
VIDEODECODER_SONAME := videodecoderaidl

MOCK_SERVICE_BIN := AVClockService
AVCLOCK_LIB := lib$(AVCLOCK_SONAME).so
AUDIOSINK_LIB := lib$(AUDIOSINK_SONAME).so
AUDIODECODER_LIB := lib$(AUDIODECODER_SONAME).so
VIDEOSINK_LIB := lib$(VIDEOSINK_SONAME).so
VIDEODECODER_LIB := lib$(VIDEODECODER_SONAME).so

MOCK_SERVICE_DIR ?= $(HAL_DIR)/service/src

BUILD_DIR ?= $(HAL_DIR)/build

AIDL_GEN_DIR ?= $(BUILD_DIR)/avclock_gen/current

COMM_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/AVSource.cpp
COMM_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/HALError.cpp
COMM_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/PropertyValue.cpp
COMM_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/State.cpp

AVCLOCK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/avclock/Capabilities.cpp
AVCLOCK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/avclock/ClockMode.cpp
AVCLOCK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/avclock/ClockTime.cpp
AVCLOCK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/avclock/IAVClockController.cpp
AVCLOCK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/avclock/IAVClockControllerListener.cpp
AVCLOCK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/avclock/IAVClock.cpp
AVCLOCK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/avclock/IAVClockEventListener.cpp
AVCLOCK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/avclock/IAVClockManager.cpp
AVCLOCK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/avclock/Property.cpp
AVCLOCK_LIB_SRC += $(COMM_LIB_SRC)

AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/Capabilities.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/ChannelType.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/Codec.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/CSDAudioFormat.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/ErrorCode.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/FrameMetadata.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/IAudioDecoderController.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/IAudioDecoderControllerListener.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/IAudioDecoder.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/IAudioDecoderEventListener.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/IAudioDecoderManager.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/PCMFormat.cpp
AUDIODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiodecoder/Property.cpp
AUDIODECODER_LIB_SRC_LIB_SRC += $(COMM_LIB_SRC)

AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/Capabilities.cpp
AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/ErrorCode.cpp
AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/IAudioSinkController.cpp
AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/IAudioSinkControllerListener.cpp
AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/IAudioSink.cpp
AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/IAudioSinkEventListener.cpp
AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/IAudioSinkManager.cpp
AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/PlatformCapabilities.cpp
AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/Property.cpp
AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/Volume.cpp
AUDIOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/audiosink/VolumeRamp.cpp
AUDIOSINK_LIB_SRC += $(COMM_LIB_SRC)

VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/Capabilities.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/CodecCapabilities.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/Codec.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/CSDVideoFormat.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/DynamicRange.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/ErrorCode.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/FrameMetadata.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/IVideoDecoderController.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/IVideoDecoderControllerListener.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/IVideoDecoder.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/IVideoDecoderEventListener.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/IVideoDecoderManager.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/OperationalMode.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/PixelFormat.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/Property.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/PropertyKVPair.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videodecoder/ScanType.cpp
VIDEODECODER_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videosink/Capabilities.cpp
VIDEODECODER_LIB_SRC += $(COMM_LIB_SRC)

VIDEOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videosink/IVideoSinkController.cpp
VIDEOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videosink/IVideoSinkControllerListener.cpp
VIDEOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videosink/IVideoSink.cpp
VIDEOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videosink/IVideoSinkEventListener.cpp
VIDEOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videosink/IVideoSinkManager.cpp
VIDEOSINK_LIB_SRC += $(AIDL_GEN_DIR)/cpp/com/rdk/hal/videosink/Property.cpp
VIDEOSINK_LIB_SRC += $(COMM_LIB_SRC)

MOCK_SERVICE_BIN_SRC := $(MOCK_SERVICE_DIR)/AVClockService.cpp
MOCK_SERVICE_BIN_SRC += $(MOCK_SERVICE_DIR)/AVClock.cpp

MOCK_SERVICE_INC_FLAGS := -I$(AIDL_GEN_DIR)/h
MOCK_SERVICE_INC_FLAGS += -I$(BUILD_DIR)/usr/include
MOCK_SERVICE_INC_FLAGS += -I$(MOCK_SERVICE_DIR)

MOCK_SERVICE_LD_LIBS := -lbinder -lutils

MOCK_SERVICE_LDFLAGS := -L$(BUILD_DIR)/usr/lib
MOCK_SERVICE_LDFLAGS += -Wl,-rpath-link=$(BUILD_DIR)/usr/lib

MOCK_SERVICE_CFLAGS := -Wall -Wextra -std=c++17 -ggdb

mock_service: $(MOCK_SERVICE_BIN) $(AVCLOCK_LIB)

$(VIDEODECODER_LIB): $(VIDEODECODER_LIB_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $(filter %.o, $^) -o $@ $(MOCK_SERVICE_LD_LIBS)
	install $(VIDEODECODER_LIB) $(BUILD_DIR)/usr/lib

$(AUDIODECODER_LIB): $(AUDIODECODER_LIB_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $(filter %.o, $^) -o $@ $(MOCK_SERVICE_LD_LIBS)
	install $(AUDIODECODER_LIB) $(BUILD_DIR)/usr/lib

$(VIDEOSINK_LIB): $(VIDEODECODER_LIB)
$(VIDEOSINK_LIB): $(VIDEOSINK_LIB_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $(filter %.o, $^) -o $@ $(MOCK_SERVICE_LD_LIBS) \
		-l$(VIDEODECODER_SONAME)
	install $(VIDEOSINK_LIB) $(BUILD_DIR)/usr/lib

$(AUDIOSINK_LIB): $(AUDIODECODER_LIB)
$(AUDIOSINK_LIB): $(AUDIOSINK_LIB_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $(filter %.o, $^) -o $@ $(MOCK_SERVICE_LD_LIBS) \
		-l$(AUDIODECODER_SONAME)
	install $(AUDIOSINK_LIB) $(BUILD_DIR)/usr/lib

$(AVCLOCK_LIB): $(AUDIOSINK_LIB) $(VIDEOSINK_LIB)
$(AVCLOCK_LIB): $(AVCLOCK_LIB_SRC:%.cpp=%.o)
	g++ -shared $(MOCK_SERVICE_LDFLAGS) $(filter %.o, $^) -o $@ $(MOCK_SERVICE_LD_LIBS) \
		-l$(AUDIOSINK_SONAME) \
		-l$(VIDEOSINK_SONAME)
	install $(AVCLOCK_LIB) $(BUILD_DIR)/usr/lib

$(MOCK_SERVICE_BIN): $(AVCLOCK_LIB)
$(MOCK_SERVICE_BIN): $(MOCK_SERVICE_BIN_SRC:%.cpp=%.o)
	g++ $(MOCK_SERVICE_LDFLAGS) \
		$(filter %.o, $^) -o $@ \
		$(MOCK_SERVICE_LD_LIBS) \
		-lpthread \
		-l$(AVCLOCK_SONAME)
	install $(MOCK_SERVICE_BIN) $(BUILD_DIR)/usr/bin

# TODO: to be compile out of source tree
%.o: %.cpp
	g++ $(MOCK_SERVICE_CFLAGS) $(MOCK_SERVICE_INC_FLAGS) -fPIC -c $< -o $@
